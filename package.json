{
  "name": "arclight",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "demo:seed": "pnpm --filter @arclight/worker demo:seed",
    "e2e": "pnpm --filter @arclight/e2e test:e2e",
    "arc:preflight": "pnpm --filter @arclight/worker arc:preflight",
    "bench": "pnpm --filter @arclight/worker bench",
    "bench:report": "pnpm --filter @arclight/worker bench:report"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.29.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.4"
  }
}
